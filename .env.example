# Pages / Worker 部署用变量（示例值，非真实密钥）
# KEY_ENCRYPTION_SECRET: 生产 DO 中 AES-256 加密厂商 API Key 的密钥，部署后在
# Cloudflare Dashboard 的 Worker / Pages 设置里以 Secret 形式填写，不要写进代码或仓库。
KEY_ENCRYPTION_SECRET="YOUR_KEY_ENCRYPTION_SECRET"

# ALLOWED_ORIGINS: 允许跨域的来源，多个用逗号分隔；生产只认 https://gateai.pages.dev，
# 边缘默认值与 wrangler 配置均为该域名，不要改回 *。
ALLOWED_ORIGINS="https://gateai.pages.dev"
